{
  "name": "@dewbow-core/host-daemon",
  "version": "0.1.0",
  "private": true,
  "description": "Dewbow Core host-side Codex runtime and durable Control Plane connection",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@dewbow-core/protocol": "0.1.0",
    "@dewbow-core/sdk": "0.1.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
