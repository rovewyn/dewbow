{
  "name": "@dewbow/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Local Codex discovery, history, and conversation execution for Node.js",
  "type": "module",
  "engines": { "node": ">=24.15.0" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "npm run build && node examples/discover.mjs",
    "demo:history": "npm run build && node examples/history.mjs"
  },
  "dependencies": { "koffi": "3.3.3" }
}
