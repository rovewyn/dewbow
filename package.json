{
  "name": "@dewbow/workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Local Codex session management with the Dewbow CLI and daemon",
  "type": "module",
  "packageManager": "npm@12.2.0",
  "allowScripts": {
    "koffi@3.3.3": true,
    "fsevents": false
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "packages/protocol",
    "packages/sdk",
    "packages/ui",
    "apps/web"
  ],
  "scripts": {
    "version:check": "node scripts/sync-version.mjs --check",
    "version:sync": "node scripts/sync-version.mjs",
    "version:set": "node scripts/sync-version.mjs --version",
    "test:release": "node --test scripts/tests/release.test.mjs",
    "release:pack": "node scripts/package-release.mjs",
    "release:check": "node scripts/package-release.mjs --check",
    "build": "npm run build --workspaces",
    "typecheck": "npm run build --workspace @dewbow/protocol && npm run build --workspace @dewbow/sdk && npm run build --workspace @dewbow/ui && npm run typecheck --workspaces",
    "test": "npm run build --workspace @dewbow/protocol && npm run build --workspace @dewbow/ui && npm test --workspaces --if-present && node --test scripts/tests/*.test.mjs",
    "demo": "npm run demo --workspace @dewbow/sdk",
    "demo:history": "npm run demo:history --workspace @dewbow/sdk --",
    "build:rust": "npm run build && cargo build --workspace --bins --examples",
    "test:rust": "cargo test --workspace --all-targets && node --test scripts/tests/rust-daemon.test.mjs",
    "web": "npm run dev --workspace @dewbow/web --",
    "web:preview": "npm run preview --workspace @dewbow/web --"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
