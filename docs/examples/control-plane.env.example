DEWBOW_CONTROL_PLANE_HOST=127.0.0.1
DEWBOW_CONTROL_PLANE_PORT=3000
DEWBOW_PUBLIC_ORIGIN=http://127.0.0.1:3000
DEWBOW_CONTROL_PLANE_STATE=state/control-plane.sqlite
DEWBOW_HOSTS_FILE=state/hosts.json
DEWBOW_MANAGEMENT_TOKEN=replace-with-management-credential
DEWBOW_OPERATOR_PASSWORD=replace-with-separate-operator-password
