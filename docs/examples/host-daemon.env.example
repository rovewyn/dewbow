DEWBOW_HOST_ID=example-host
DEWBOW_HOST_TOKEN=replace-with-this-host-credential
DEWBOW_CONTROL_PLANE_URL=http://127.0.0.1:3000
DEWBOW_HOST_STATE=state/host-daemon.sqlite
DEWBOW_CODEX_EXECUTABLE=codex
# CODEX_HOME uses the locally configured Codex home when omitted.
# Cross-machine connections require a reachable HTTPS origin.
# NODE_EXTRA_CA_CERTS=state/private-ca.pem
